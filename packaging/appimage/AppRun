#!/bin/sh
# AppImage entry point. Electron's Chromium sandbox helper cannot keep its setuid
# bit inside a squashfs image, so the flag Chromium expects here is --no-sandbox.
HERE="$(dirname "$(readlink -f "$0")")"
export XENITY_APPIMAGE_DIR="$HERE"
exec "$HERE/usr/lib/xenity/xenity" --no-sandbox "$@"
